#################################################################################################################################################
# Function Edit-NPEActiveDirectoryUserPassword                                                                             Tested in Section CE
#################################################################################################################################################
<# 
 .SYNOPSIS 
	 Changing an ID's password in AD

 .DESCRIPTION 
	 Changing an ID's password in AD.  The script will first check to see if the password is already the correct password.  Will return a value of $True if successful or $False if not.

 .PARAMETER <UserName>
     This is the Pre-Windwos2000 user ID for a user that is in Active 
     Directory

 .PARAMETER <NewPassword>
     This is the text that the password will be changed to.

 .PARAMETER <DomainName>
     OPTIONAL: This is the name of the domain you are connecting to for this operation.   By default NPPC will be connecting to the Nestle domain and this should not be needed. 

 .EXAMPLE 
     $Success = Edit-NPEActiveDirectoryUserPassword $TestUserID "Th!5!sMyN3wPW0rd"

#> 
Function Edit-NPEActiveDirectoryUserPassword
{
  [CmdletBinding(SupportsShouldProcess=$True)]
  Param(
    [Parameter(Mandatory=$True)]  [string]$UserName,
    [Parameter(Mandatory=$True)]  [string]$NewPassword,
    [Parameter(Mandatory=$False)] [string]$DomainName
  ) # EndParam

  $FunctionName = "Edit-NPEActiveDirectoryUserPassword "
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): -------------------------------------" $false
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): >>>>>Loading" $false

  Add-Type -AssemblyName System.DirectoryServices.AccountManagement
  $ct = [System.DirectoryServices.AccountManagement.ContextType]::Domain
  #_# If $DomainName has not been supplied, we need to check for it and populate it.
  $pc = New-Object System.DirectoryServices.AccountManagement.PrincipalContext($ct, $DomainName)
  if ($pc.ValidateCredentials($UserName, $NewPassword)){
    # If it is valid, then no need to change it.
    Log-NPEWrite $ScriptLogFullName "$($Username) password already correct in AD." $true
    $Success = $True
  }Else{
    if ($TestOnly -eq $True){
      Log-NPEWrite $ScriptLogFullName "$($FunctionName): TEST ONLY: Next step would set the password for ID $($UserName)" $true
      $Success = $False
    }Else{
      $NewSecurePassword = Convert-NPETextToSecureString $NewPassword
      $Result = Set-ADAccountPassword -Identity $UserName -NewPassword $NewSecurePassword -Reset -PassThru
      Log-NPEWrite $ScriptLogFullName "$($FunctionName): $($UserName) was updated in AD.  Pausing for 30 seconds so that validation works correctly."
      # Need to wait to AD for catch up with itself.   If we check too quickly the response from AD is that it was not successful.
      Start-Sleep -s 30
      Add-Type -AssemblyName System.DirectoryServices.AccountManagement
      $ct = [System.DirectoryServices.AccountManagement.ContextType]::Domain
      $pc = New-Object System.DirectoryServices.AccountManagement.PrincipalContext($ct, $DomainName)
      if ($pc.ValidateCredentials($UserName, $NewPassword)){
        Log-NPEWrite $ScriptLogFullName "$($FunctionName): $($NewUSerID) password change successfully in AD." $true
        $Success = $True
      }else{
        Log-NPEError $ScriptLogFullName "$($FunctionName): $($NewUserID) Password change failed in AD."
        Log-NPEError -LogPath $ScriptLogFullName -ErrorDesc "$($FunctionName):$($NewUserID):$($NewPassword): Error: $($_.Exception)"
        $Success = $False
      } # EndIf
    } # EndIf
  } # EndIf
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): <<<<<Exiting $($FunctionName) with result: $($Result))" $false
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): -------------------------------------" $false
  Return $Success
} # End Edit-NPEActiveDirectoryUserPassword

