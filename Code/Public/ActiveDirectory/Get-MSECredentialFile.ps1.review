
#################################################################################################################################################
# Function Get-NPECredentialFile                                                                                             Tested in Section DN
#################################################################################################################################################
<#
 .SYNOPSIS
    This function is used to retrieve a user name and password combination from a file.
 .DESCRIPTION
 .NOTES 
     Author       : 	 Borrowed from BTC
     Version Date : 	 Version 1.0 - Adapted for use in NPPC scripts
    MUST to be made compliant with std
 .EXAMPLE
#>  
Function Get-NPECredentialFile
{
  [CmdletBinding(SupportsShouldProcess=$True)]
  Param(
    [Parameter(Mandatory=$True)] [string] $fnUser,
    [Parameter(Mandatory=$True)] [string] $fnFile
  ) # EndParam
  # Define local variables
  $FunctionName = "Get-NPECredentialFile"
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): -------------------------------------" $false
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): >>>>>Loading" $false
  $Result = $ReturnFailure
  $Credential = $null
  Try 
  {
    Log-NPEWrite $ScriptLogFullName "$($FunctionName): Entering TRY:" $false
    If (Test-Path $fnFile){
      $fnPassword = Get-Content $fnFile | ConvertTo-SecureString 
      $Credential = New-Object System.Management.Automation.PsCredential($fnUser,$fnPassword)
      $Result = $ReturnSuccess
    }Else{
      Log-NPEWrite $ScriptLogFullName "$($FunctionName): Credential File Not Found" $true
    }  
    Log-NPEWrite $ScriptLogFullName "$($FunctionName): Exiting TRY:" $false
  } # EndTry
  Catch 
  {
    Log-NPEWrite $ScriptLogFullName "$($FunctionName): Entering CATCH:" $false
    #
    $Credential = $null
    $Result = $false
    #
    Log-NPEWrite $ScriptLogFullName "$($FunctionName): Exiting CATCH:" $flase
  } # EndCatch
  Finally 
  {
    Log-NPEWrite $ScriptLogFullName "$($FunctionName): Entering FINALLY:" $flase
    #
    # XXX Add code here
    #
    Log-NPEWrite $ScriptLogFullName "$($FunctionName): Exiting FINALLY:" $false
  } # EndFinal
  #
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): <<<<<Exiting $($FunctionName) with result: $($Result))" $false
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): -------------------------------------" $false
  Return $Credential
} # End Get-NPECredentialFilef