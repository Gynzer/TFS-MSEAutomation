#################################################################################################################################################
# Function Get-SecurePWToText                                                                                                Tested in Section DQ
#################################################################################################################################################

<#
 .SYNOPSIS
    This function will change a secure password to a text password by simply supplying the secure password.
 .DESCRIPTION
    This function will change a secure password to a text password by simply supplying the secure password.
 .NOTES 
     Author       : 	 Ron Gines
     Version      : 	 Version 1.0 
     Date         :      March 11, 2015
     Description  :      Initial Version of the script
 .EXAMPLES
    $NewTextPassword = Get-SecurePWToText $OldSecurePassword
#>  
Function Get-SecurePWToText
{
  [CmdletBinding(SupportsShouldProcess=$True)]
  Param(
    [Parameter(Mandatory=$True)] [Security.SecureString]$SecurePassword
  ) # EndParam
  # Define local variables
  $FunctionName = "Get-SecurePWToText"
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): -------------------------------------" $false
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): >>>>>Loading" $false

  $BSTR = ` [System.Runtime.InteropServices.Marshal]::SecureStringToBSTR($SecurePassword)
  $PlainTextPassword = [System.Runtime.InteropServices.Marshal]::PtrToStringAuto($BSTR)

  Log-NPEWrite $ScriptLogFullName "$($FunctionName): <<<<<Exiting $($FunctionName) with result: $($Result))" $false
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): -------------------------------------" $false
  Return $PlainTextpassword
} # End Get-SecurePWToText