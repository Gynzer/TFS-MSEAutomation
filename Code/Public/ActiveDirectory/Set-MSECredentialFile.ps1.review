
#################################################################################################################################################
# Function Set-NPECredentialFile                                                                                             Tested in Section DM
#################################################################################################################################################

<#
 .SYNOPSIS
    This function is used to store a user name and password combination in a secure string to a file.
 .DESCRIPTION
    This function is used to store a user name and password combination in a secure string to a file.
 .NOTES 
    Author       : 	 Borrowed from BTC
    Version      : 	 Version 1.0 - 
    Date         :   02/09/2015
    Purpose      :   Adapted for use in NPPC scripts
 .EXAMPLE
    Set-NPECredentialFile $Credential $CredentialFileLocation
#>  
Function Set-NPECredentialFile
{
  [CmdletBinding(SupportsShouldProcess=$True)]
  Param(
    [Parameter(Mandatory=$True)] [System.Management.Automation.PsCredential] $fnCredential,
    [Parameter(Mandatory=$True)] [string] $fnFile
  ) # EndParam
  $FunctionName = "Set-NPECredentialFile"
  $Result = $false
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): -------------------------------------" $false
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): >>>>>Loading $($Functionname)" $false
  [boolean]$Result = $False
  Try 
  {
    Log-NPEWrite $ScriptLogFullName "$($FunctionName): Entering TRY:" $false
    Log-NPEWrite $ScriptLogFullName "$($FunctionName): Ready to write to $($fnFile)." $true
    $fnCredential.Password | ConvertFrom-SecureString | Set-Content $fnFile
    $Result = $true
    Log-NPEWrite $ScriptLogFullName "$($FunctionName): Exiting TRY:" $false
  } # EndTry
  Catch 
  {
    Log-NPEWrite $ScriptLogFullName "$($FunctionName): Entering CATCH:" $false
    #
    $Result = $false
    #
    Log-NPEWrite $ScriptLogFullName "$($FunctionName): Exiting CATCH:" $false
  } # EndCatch
  Finally 
  {
    Log-NPEWrite $ScriptLogFullName "$($FunctionName): Entering FINALLY:" $false
    If (Test-Path $fnFile){
      Log-NPEWrite $ScriptLogFullName "$($FunctionName): File $($fnFile) was written." $true
    }Else{
      Log-NPEWrite $ScriptLogFullName "$($FunctionName): File $($fnFile) was NOT written." $true
    }
    Log-NPEWrite $ScriptLogFullName "$($FunctionName): Exiting FINALLY:" $false
  } # EndFinal
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): <<<<<Exiting $($FunctionName) with result: $($Result))" $false
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): -------------------------------------" $false
  Return $Result
} # End Set-NPECredentialFile