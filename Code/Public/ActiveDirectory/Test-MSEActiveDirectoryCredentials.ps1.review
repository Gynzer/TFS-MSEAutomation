#################################################################################################################################################
# Function Test-NPEActiveDirectoryCredentials                                                                                Tested in Section DO
#################################################################################################################################################

<#
 .SYNOPSIS
    This function verifies that the passed User name and Password combination are successful credentials.
 .DESCRIPTION
    It attempts to connect to the Active Directory infrastructure that the machine is a member of, to verify if the user name and password combination a valid to log in.
 .NOTES 
     Author       : 	 Borrowed from BTC
     Version Date : 	 Version 1.0 - Adapted for use in NPPC scripts
 .EXAMPLES
    Returns true if the credentials are valid, false if they are not able to log in.
 .EXAMPLE
    $ValidCredentials = Test-NPEActiveDirectoryCredentials first.last@rrr.nestle.com myPassword
    Test credentials in User Principal Name format
 .EXAMPLE
    $ValidCredentials = Test-NPEActiveDirectoryCredentials nestle\flast myPassword
    Test credentials in Netbios format
#>  
Function Test-NPEActiveDirectoryCredentials    
{
  [CmdletBinding(SupportsShouldProcess=$True)]
  Param(
    [Parameter(Mandatory=$True)] [string]$UserName,  # like first.last@rrr.nestle.com or domain\userid 
    [Parameter(Mandatory=$True)] [string]$UserPassword
  ) # EndParam
  # Define local variables
  $FunctionName = "Test-NPEActiveDirectoryCredentials"
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): -------------------------------------" $false
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): >>>>>Loading" $false
  [boolean]$Result = $False
  $Path=(Get-ADRootDSE).defaultNamingContext
#  [string]$Path="LDAP://$Global:WCLComputer.ADDefaultNamingContext"
  Try 
  {
    Log-NPEWrite $ScriptLogFullName "$($FunctionName): Entering TRY:" $false
    If ($Path -eq "") {
      Throw ("Variable $($Path) has not been initialized. Please execute $Global:WCLComputer ComputerClass Object before running this function")
    }
    Log-NPEWrite $ScriptLogFullName ("Try to bind AD with user:" + $UserName)  $true
    Log-NPEWrite $ScriptLogFullName ("Active Directory Default Naming Context:" + $Path) $true
    $AD =  New-Object System.DirectoryServices.DirectoryEntry($Path, $UserName, $UserPassword)
    [Object]$obj = $AD.NativeObject
    $Result=$True
    Log-NPEWrite $ScriptLogFullName "$($FunctionName): Exiting TRY:" $false
  } # EndTry
  #
  Catch 
  {
    Log-NPEWrite $ScriptLogFullName "$($FunctionName): Entering CATCH:" $false
    Log-NPEError $ScriptLogFullName "$($FunctionName): Cannot Find User $UserName in $($Path)"
    $Result=$false
    Log-NPEWrite $ScriptLogFullName "$($FunctionName): Exiting CATCH:" $false
  } # EndCatch 
  #
  Finally 
  {
    Log-NPEWrite $ScriptLogFullName "$($FunctionName): Entering FINALLY:" $false
    #
    # XXX Add code here
    #
    Log-NPEWrite $ScriptLogFullName "$($FunctionName): Exiting FINALLY:" $false
  } # EndFinally
  #
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): <<<<<Exiting $($FunctionName) with result: $($Result))" $false
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): -------------------------------------" $false
  Return $Result
} # End Test-NPEActiveDirectoryCredentials