#################################################################################################################################################
# Function New-NPEPassword                                                                                                Tested in Section EP
#################################################################################################################################################
<# 
 .SYNOPSIS 
	 Generates a password for MESAPPS
 .DESCRIPTION 
	 Function generates a new password for use in MESAPPS property files.   It is
     designed to be compliant with Nestle standards as well as with restrictions 
     that have been identified with the MESAPPS application suite.
 .NOTES 
     Author       : 	 Ron Gines
     Version Date : 	 Version 1.0 - Cleaned up for first NPPC release
 .PARAMETER <Length>
     This is a number that defines the length of the password.   Anything less
     than 4 will default to 4.
 .EXAMPLE 
	 $NewPassword = Generate-NPEPassword 16
     Will generate a password 16 characters in length.
#> 
function New-NPEPassword
{
  [CmdletBinding(SupportsShouldProcess=$True)]
  Param(
    [Parameter(Mandatory=$True)] [int]$Length
  ) # EndParam
  $FunctionName = "New-NPEPassword"
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): -------------------------------------" $false
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): >>>>>Loading $($FunctionName)" $false
  # Write-Host $Length
  If ($Length -lt 4) {$Length = 4}
  do{ 
    # First we generate a random password longer than we think we will need.
    $NewPassWord = $(foreach ($i in 1..([math]::truncate($Length*1.4))){Get-Random -InputObject $NPPC_AllowedADPasswordCharacters }) -join '' 
    # Now we make sure that there are no repeated characters.
    For ($i = 1; $i -lt $NewPassword.length; $i++){ 
      $NewPassword = $NewPassword.Substring(0, $i) + `
      $NewPassword.Substring($i).`
      replace($NewPassword.`
      Substring($i-1, 1), "")
    } # End For
    # Now we trim the password to Length.
    If ($NewPassword.length -gt $Length){ 
      $NewPassword = $NewPassword.Substring(0,$Length) 
    } # End If
  } # End Do
  # Now we check to make sure that the character requirements are in place.
  until (
    ( $NewPassword -cmatch '[A-Z]' ) -and
    ( $NewPassWord -cmatch '[a-z]' ) -and
    ( $NewPassWord -imatch '[0-9]' ) -and 
    ( $NewPassword.length -eq $Length ) -and
    ( $NewPassWord -imatch '[^A-Z0-9]' )
  ) # End Until
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): <<<<<Exiting $($FunctionName)" $false
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): -------------------------------------" $false
  return $NewPassword
} # End New-NPEPassword

