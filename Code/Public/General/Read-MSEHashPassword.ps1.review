#################################################################################################################################################
# Function Read-NPEHashPassword                                                                                              Tested in Section EN
#################################################################################################################################################
<# 
 .SYNOPSIS 
	 Function to get the password from a hashfile stored in the variable $Global:NPPC_PasswordHashDirectory
 .DESCRIPTION 
	 Function to get the password from a hashfile stored in the variable $Global:NPPC_PasswordHashDirectory.   The 
     file name is assumed to be the format of <machinename>-<userid>.hash
 .NOTES 
     Author       : 	 Ron Gines
     Version Date : 	 Version 1.0 - Cleaned up for first NPPC release
 .PARAMETER <HashFile>
     This is a text representation of the password to be tested
 .EXAMPLE   
	 $EncryptedPassword = Read-HashPassword "SantaClaus" "C:\Temp\MyPWHashFileForSYetmXYZ.hash"
#> 
#### NEED TO ADD A CONDITIONAL RETURN FOR
####   SecureString
####   Text
####   Raw Hash
####   Credential (Need the ID for this piece)

#### Also need to add option to just return hash or check hash with ID against AD.


  
Function Read-NPEHashPassword
{
  [CmdletBinding(SupportsShouldProcess=$True)]
  Param(
    [Parameter(Mandatory=$True)] [string]$UserID,
    [Parameter(Mandatory=$True)] [string]$HashFile,
    [string]$Password
  ) # EndParam
  $FunctionName = "Read-NPEHashPassword"
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): -------------------------------------" $false
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): >>>>>Loading" $false
  $HashResults = @{}
  If (Test-Path -Path $HashFile) {
    # We continue
  }else{
    $HashResults.Text = "The hashfile could not be found." 
    $HashResults.Result = $False
    $HashResults.HashPassword = $null
    $Hashresults.SecureHashPassword = $null
    Log-NPEWrite $ScriptLogFullName "The hashfile could not be found." $true
    Log-NPEWrite $ScriptLogFullName "$($FunctionName): <<<<<Exiting $($FunctionName) with result: $($HashResults.Result))" $false
    Log-NPEWrite $ScriptLogFullName "$($FunctionName): -------------------------------------" $false
    Return, $HashResults
  }
  $HashPassword = Get-Content $HashFile | Select-Object -first 1
  $SecureHashPassword = $HashPassword | ConvertTo-SecureString
  $ProductionCredential = New-Object System.Management.Automation.PsCredential($UserID,$SecureHashPassword)
  $ProductionPassword = $ProductionCredential.GetNetworkCredential().password
  Add-Type -AssemblyName System.DirectoryServices.AccountManagement
  $ct = [System.DirectoryServices.AccountManagement.ContextType]::Domain
  $pc = New-Object System.DirectoryServices.AccountManagement.PrincipalContext($ct, $NPPC_Domain_NT)
  If ($UserID -eq $null){
    $TestIDADUserExistenceTmp = $false
  }else{
    $TestIDADUserExistenceTmp = Test-NPEActiveDirectoryUserExists $UserID
  }
  if ($TestIDADUserExistenceTmp){
    if ($pc.ValidateCredentials($UserID, $ProductionPassword)){
      $HashResults.Text = "The Imported Production UserID and Password are valid." 
      $HashResults.Result = $True
      Log-NPEWrite $ScriptLogFullName "The Imported Production UserID and Password are valid." $true
    }else{
      $HashResults.Text = "The Imported Production UserID and Password are NOT valid."
      $HashResults.Result = $False
      Log-NPEWrite $ScriptLogFullName "The Imported Production UserID and Password are NOT valid." $true 
    }
  }else{
    $HashResults.Text = "The User ID $($UserID) does not exist in AD.   The password will be returned, but not validated."
    $HashResults.Result = $True
    Log-NPEWrite $ScriptLogFullName "The User ID $($UserID) does not exist in AD.   The password will be returned, but not validated." $true 
  } 
  $HashResults.HashPassword = $HashPassword
  $Hashresults.SecureHashPassword = $SecurehashPassword
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): <<<<<Exiting $($FunctionName) with result: $($HashResults.Result))" $false
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): -------------------------------------" $false
  Return, $HashResults
} # End Function Read-NPEHashPassword
   