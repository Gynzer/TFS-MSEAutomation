#################################################################################################################################################
# Function Test-NPEMESAPPSEncryptPassword                                                                                    Tested in Section EG
#################################################################################################################################################
<# 
 .SYNOPSIS 
	 Function to encrypt a password for use in an MESAPPS property file.
 .DESCRIPTION 
	 This funtion will take a text based password as a parameter along with the 
     property file password parameter and will test that the password can be 
     properly encrypted, stored in a property file and then properly 
     decrypted withuot errors.  If successful, function will return an 
     object with the encrypted password, otherwise the object will report 
     that it failed with a reason code.
 .NOTES 
     Author       : 	 Ron Gines
     Version Date : 	 Version 1.0 - Cleaned up for first NPPC release
 .PARAMETER <TextPW>
     This is a text representation of the password to be tested
 .PARAMETER <PWParameter>
     This is a text representation of the property file parameter to be tested
 .PARAMETER <EncryptType>
     Determines the version of the encrypt code being used.   Default is "Classic" MES.   Other value is "AES"
 .EXAMPLE   
	 $EncryptedPassword = Test-NPEMESAPPSEncryptPassword "N0rth!P0l3" "db.username"
#> 
function Test-NPEMESAPPSEncryptPassword
{
  [CmdletBinding(SupportsShouldProcess=$True)]
  Param(
    [Parameter(Mandatory=$True)] [string]$TextPW,
    [Parameter(Mandatory=$True)] [string]$PWParameter,
    [string]$EncryptType="Classic"
  ) # EndParam
  $FunctionName = "Test-NPEMESAPPSEncryptPassword"
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): -------------------------------------" $false
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): >>>>>Loading $($FunctionName)" $false
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): PWParameter as passed to function: $($PWParameter)" $false
  $ValidPW = $True
  $Reason = "Password Encrypted Correctly.  We are good!!"
  $TimeStamp = Get-NPEUniqueTimeStamp
  $TmpString = "$($PWParameter)=$($TextPW)"
  $TmpFile   = "$($NPPC_MESAPPSTestDir)\Temp$($TimeStamp).property"
  Out-File -filepath $TmpFile -inputobject "#" -Encoding "UTF8" 
  Out-File -filepath $TmpFile -inputobject $TmpString -Encoding "UTF8" -Append
  Out-File -filepath $TmpFile -inputobject "#" -Encoding "UTF8" -Append
  ### Checking to see what version of MCF is installed to see if new encryption is in place or not.
  $EncryptVersion = Get-NPEMESAPPSPropertyParameter "$($NPPC_RPMISCDir)\version.properties" "app.version" ""
  Log-NPEWrite $ScriptLogFullName ">>>>>>$($FunctionName):  encrypt.cmd $($TmpFile) $($PWParameter) Version: $($EncryptVersion.Value)  EncryptType: $($EncryptType)" $false
  If ( $EncryptVersion.Value -ge "12.0.0"){
    If ( $EncryptType -eq "Classic" ) {
      $CMD = [scriptblock]::Create("$($NPPC_RPMISCDIR)\RPMISC\encrypt.cmd -o $($TmpFile) $($PWParameter) ")
    }else{
      $CMD = [scriptblock]::Create("$($NPPC_RPMISCDIR)\RPMISC\encrypt.cmd $($TmpFile) $($PWParameter) ")
    }
    Log-NPEWrite $ScriptLogFullName "$($FunctionName): Encrypt Command has been set to $($CMD)." $false
  }else{
    If ( $EncryptType -eq "Classic" ) {
      $CMD = [scriptblock]::Create("$($NPPC_RPMISCDIR)\RPMISC\encrypt.cmd $($TmpFile) $($PWParameter) ")
      Log-NPEWrite $ScriptLogFullName "$($FunctionName): Encrypt Command has been set to $($CMD)." $false
    }else{
      $ValidPW = $false
      $Reason = "New AES password encryption is not available"
      $EncryptReturn = @( $encryptpassword, $ValidPW, $Reason )
      $value = "" | Select-Object -Property EncryptPW,ValidPW,Reason
      $value.EncryptPW = $null
      $value.ValidPW = $ValidPW
      $value.Reason = $Reason
      Log-NPEWrite $ScriptLogFullName "$($FunctionName): <<<<<Exiting $($FunctionName) with result: $($value.ValidPW))" $false
      Log-NPEWrite $ScriptLogFullName "$($FunctionName): -------------------------------------" $false
      return $value
    }
  }
  $CMDResult = $CMD.Invoke()
  $content = Get-Content $TmpFile
#  if ( $content -match "^$PWParameter\s*=" ){
  if ( $content -match "^$PWParameter\s*" ){
    $TmpEncryption = $content -split "="
    $encryptpassword = $TmpEncryption[2]
    $EncryptSets = $TmpEncryption.Length
    # Check to see if the password even encrypted in the first place
    if ( $encryptpassword -eq $TextPW ){
      $ValidPW = $false
      $Reason = "Password did not Encrypt."
    }Else{
      If ($EncryptType -eq "Classic") {
        ForEach ($Char in $NPPC_DisallowedEncryptedPasswordCharacters){
          if ($encryptpassword.contains($Char) -eq $true){
            $ValidPW = $false
            $Reason = "Encrypted Password was Rejected as not usable due to a disallowed character :$($Char): in our property files."
            Log-NPEWrite $ScriptLogFullName $($Reason) $false
          } # End If
        }# Next $Char
      } # End If
    }# End If
  }else{
    $ValidPW = $false
    $Reason = "Key: $($PWParameter) was not found in the file $($PWFile)."
  } # End If
  # We are testing to make sure that the encrypted password will decrypt back to the original password
  $CMD2 = [scriptblock]::Create("$($NPPC_RPMISCDir )\RPMISC\encrypt.cmd -d $($TmpFile) $($PWParameter)")
  $CMD2Result = $CMD2.Invoke()

$CMDResult

  $NewTmpTest = ($CMD2Result | Select-String '=') -split " = "

$NewTmpTest

  If ($ValidPW -eq $true){
    If ( $TextPW -eq $NewTmpTest[1]){
      Log-NPEWrite $ScriptLogFullName "$($FunctionName): Decrypt Test: PASSED" $true
    }Else{
      Log-NPEWrite $ScriptLogFullName "$($FunctionName): Decrypt Test FAILED." $true
      $ValidPW = $false
    } # End If
  } # End If
  # Removing the temp file.   We wont need it either way any more.
  If (Test-Path $TmpFile){
	Remove-Item $TmpFile
  }
  If ($TestOnly)
  {
     Log-NPEWrite $ScriptLogFullName  $TextPW  $false
     Log-NPEWrite $ScriptLogFullName  $encryptpassword  $false
     Log-NPEWrite $ScriptLogFullName    $false
  }
  $EncryptReturn = @( $encryptpassword, $ValidPW, $Reason )
  $value = "" | Select-Object -Property EncryptPW,ValidPW,Reason
  $value.EncryptPW = $encryptpassword
  $value.ValidPW = $ValidPW
  $value.Reason = $Reason
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): <<<<<Exiting $($FunctionName) with result:: $($value.ValidPW))" $false
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): -------------------------------------" $false
  return $value
} # End Test-NPEMESAPPSEncryptPassword

