#################################################################################################################################################
# Function Write-NPEHashPassword                                                                                             Tested in Section EM
#################################################################################################################################################
<# 
 .SYNOPSIS 
	 Function to add the password to a hashfile stored in the variable $Global:NPPC_PasswordHashDirectory
 .DESCRIPTION 
	 Function to add the password to a hashfile stored in the variable $Global:NPPC_PasswordHashDirectory.   The 
     file name is assumed to be the format of <machinename>-<userid>.hash

 .NOTES 
     Author       : 	 Ron Gines
     Version Date : 	 Version 1.0 - Cleaned up for first NPPC release
 .PARAMETER <Password>
     This is the password to be hashed
 .PARAMETER <TargetFile>
     This is directory where the hash file will be created.
 .EXAMPLE   
	 Write-HashPassword "N0rth!P0l3" "C:\Temp\MyPWHashFileForSYetmXYZ.hash"
#> 
   
Function Write-NPEHashPassword
{
  [CmdletBinding(SupportsShouldProcess=$True)]
  Param(
    [Parameter(Mandatory=$True)] [string]$UserID,
    [Parameter(Mandatory=$True)] [string]$Password,
    [Parameter(Mandatory=$True)] [string]$TargetFile
  ) # EndParam
  $SecurePassword=ConvertTo-SecureString $Password –asplaintext –force 
  ConvertFrom-SecureString $SecurePassword | out-file "$($TargetFile)"
} # End Function Write-NPEHashPassword

