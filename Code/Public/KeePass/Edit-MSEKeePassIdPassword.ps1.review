#################################################################################################################################################
# Function Edit-NPEKeePassIDPassword                                                                                       Tested in Section KE
#################################################################################################################################################
<# 
 .SYNOPSIS 
	 Create an ID within KeePass
 .DESCRIPTION 
	 Create an ID within KeePass
 .NOTES 
     Author       : 	 Ron Gines
     Version Date : 	 Version 1.0 - Cleaned up for first NPPC release
     Version Date : 	 Version 1.1 - Added Key File Authentication
 .PARAMETER <username>
     This is the Pre-Windwos2000 user ID for a user which may be in Active 
     Directory and needs to be cataloged in a KeePass file.
 .PARAMETER <KPFile>
     This is the fully qualified directory and filename of the target 
     KeePass file.
 .PARAMETER <KPPassword>
     This is the password required to access the KeePass file.
 .PARAMETER <NewPassword>
     This is the password for the user to be added to the KP file.
 .PARAMETER <KPDir>
     This is the fully qualified directory path to the KPScript.exe file.
 .EXAMPLE 
	 if ((Change-IDKPExistence "PUClausSa "G:\MESAPPS\TempKeePass.kdbx" "Th1s1saF1n3M355" "MyNewPa55W0rd" "G:\MESAPPS\COMMON\RPMISC\PowerShell\Keepass") -eq $true)
     The if the ID PUClausSa is in the KeePass file, then the returned 
     result will be $true
#> 
Function Edit-NPEKeePassIDPassword
{
  [CmdletBinding(SupportsShouldProcess=$True)]
  Param(
    [Parameter(Mandatory=$True)] [string]$username,
    [Parameter(Mandatory=$True)] [string]$KPFile,
    [Parameter(Mandatory=$True)] [string]$KPPassword,
    [Parameter(Mandatory=$True)] [string]$NewPassword,
    [Parameter(Mandatory=$True)] [string]$KPDir,
#    [AllowNull()][AllowEmptyString][string]$KPFileKey  ## for some reason this was not needed with AD-IDTools.ps1 - may need to do more research. it was needed on other functions.
    [string]$KPFileKey
  ) # EndParam
  if ((Test-NPEKeePassID $username $KPFile $KPPassword $KPDir $KPFileKey) -eq $true){ 
    #  Changing Password for ID in KeePass
    If($KPFileKey){
       $TempKP = $KPDir + '\kpscript.exe -c:EditEntry "' + $KPFile + '" -pw:"' + $KPPassword + '" -ref-UserName:"' + $username + '" -set-Password:"' + $NewPassword + '" -CreateBackup -keyfile:"' + $KPFileKey + '"'
    }Else{
       $TempKP = $KPDir + '\kpscript.exe -c:EditEntry "' + $KPFile + '" -pw:"' + $KPPassword + '" -ref-UserName:"' + $username + '" -set-Password:"' + $NewPassword + '" -CreateBackup' 
    }
    if ($TestOnly -eq $true){
      Write-Host "TEST ONLY: Next step would change the password for ID $($username) in Keepass."
      $Success = $False
    }Else{
      $TempKPOut = [string](Invoke-Expression -Command $TempKP)
      if ($TempKPOut.StartsWith("OK")){
        Write-Host "KeePass Password Change process completed OK.   Now we confirm the change."
        #  Checking on Changed PW in KeePass
###
        if($KPFileKey){
           $TempKP = $KPDir + '\kpscript.exe -c:GetEntryString "' + $KPFile + '" -pw:"' + $KPPassword + '" -Field:Password -ref-UserName:"' + $username + '" -keyfile:"' + $KPFileKey + '"'
        }Else{
           $TempKP = $KPDir + '\kpscript.exe -c:GetEntryString "' + $KPFile + '" -pw:"' + $KPPassword + '" -Field:Password -ref-UserName:"' + $username + '"'
        }
        $TempKPOut = [string](Invoke-Expression -Command $TempKP)
        if ($TempKPOut.StartsWith($NewPassword)){ 
          Write-Host "$($username) password successfully changed in KeePass"
          $Success = $True
        }Else{
          Write-Host "$($username) password WAS NOT changed in KeePass.   May need to be manually changed." -backgroundcolor "Red"
          $Success = $False
        } # EndIf
      }else{
        Write-Host "$($username) NOT changed successfully in Keepass.  May need to be manually updated." -backgroundcolor "Red"
        $Success = $False
      } # EndIf
    } # EndIf
  }else{
    Write-Host "$($username) was not found in KeePass."
    $Success = $False
  } # EndIf
  Return $Success
} # End Function Edit-NPEKeePassIDPassword

