#################################################################################################################################################
# Function Get-NPEKeePassIDPassword                                                                                      
#################################################################################################################################################
<# 
 .SYNOPSIS 
	 Get an IDs password within KeePass
 .DESCRIPTION 
	 Get an IDs password within KeePass
 .NOTES 
     Author       : 	 Ron Gines
     Version Date : 	 Version 1.0 - 10/27/2015
     Version Date : 	 Version 1.1 - Added Key File Authentication
 .PARAMETER <username>
     This is the Pre-Windwos2000 user ID for a user which may be in Active 
     Directory and needs to be cataloged in a KeePass file.
 .PARAMETER <KPFile>
     This is the fully qualified directory and filename of the target 
     KeePass file.
 .PARAMETER <KPPassword>
     This is the password required to access the KeePass file.
 .PARAMETER <NewPassword>
     This is the password for the user to be added to the KP file.
 .PARAMETER <KPDir>
     This is the fully qualified directory path to the KPScript.exe file.
 .EXAMPLE 
	 Get-NPEKeePassIDPassword "PUClausSa "G:\MESAPPS\TempKeePass.kdbx" "Th1s1saF1n3M355" "G:\MESAPPS\COMMON\RPMISC\PowerShell\Keepass"
     Returns the value of the password for ID PUClausSa. 
#> 
Function Get-NPEKeePassIDPassword
{
  [CmdletBinding(SupportsShouldProcess=$True)]
  Param(
    [Parameter(Mandatory=$True)] [string]$username,
    [Parameter(Mandatory=$True)] [string]$KPFile,
    [Parameter(Mandatory=$True)] [string]$KPPassword,
    [Parameter(Mandatory=$True)] [string]$KPDir,
    [string]$KPFileKey
  ) # EndParam
  $FunctionName = "Test-NPEKeePassID"
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): -------------------------------------" $false
  Log-NPEWrite $ScriptLogFullName "$($FunctionName): Loading $($FunctionName)" $false
  if ((Test-NPEKeePassID $username $KPFile $KPPassword $KPDir $KPFileKey) -eq $true){ 
    #  Changing Password for ID in KeePass
    if($KPFileKey){
       $TempKP = $KPDir + '\kpscript.exe -c:GetEntryString "' + $KPFile + '" -pw:"' + $KPPassword + '" -ref-UserName:"' + $username + '" -Field:Password -keyfile:"' + $KPFileKey + '"'
    }Else{
       $TempKP = $KPDir + '\kpscript.exe -c:GetEntryString "' + $KPFile + '" -pw:"' + $KPPassword + '" -ref-UserName:"' + $username + '" -Field:Password'
    }
###
    $TempKPOut = [string](Invoke-Expression -Command $TempKP)
    if ($TempKPOut -match "OK"){
      Log-NPEWrite $ScriptLogFullName "$($FunctionName): KeePass lookup processed OK." $true
      $PasswordArray = @{}
      $PasswordArray = $TempKPOut.split(" OK:")
      $KPUserPassword = $PasswordArray[0].trim()
    }else{
      Log-NPEWrite $ScriptLogFullName "$($FunctionName): $($username) lookup failed in Keepass." $true
      $KPUserPassword = $null
    } # EndIf
  }else{
    Log-NPEWrite $ScriptLogFullName "$($FunctionName): $($username) was not found in KeePass." $true
    $KPUserPassword = $null
  } # EndIf
  Return $KPUserPassword
} # End Function Get-NPEKeePassIDPassword

