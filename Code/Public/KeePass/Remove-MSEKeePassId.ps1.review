#################################################################################################################################################
# Function Remove-NPEKeePassID                                                                                               Tested in Section KG
#################################################################################################################################################
<# 
 .SYNOPSIS 
	 Delete an ID within KeePass
 .DESCRIPTION 
	 Delete an ID within KeePass
 .NOTES 
     Author       : 	 Ron Gines
     Version Date : 	 Version 1.0 - Cleaned up for first NPPC release
     Version Date : 	 Version 1.1 - Added Key File Authentication
 .PARAMETER <username>
     This is the Pre-Windwos2000 user ID for a user which may be in Active 
     Directory and needs to be deleted from a KeePass file.
 .PARAMETER <KPFile>
     This is the fully qualified directory and filename of the target 
     KeePass file.
 .PARAMETER <KPPassword>
     This is the password required to access the KeePass file.
 .PARAMETER <KPDir>
     This is the fully qualified directory path to the KPScript.exe file.
 .EXAMPLE 
	 if ((Test-NPEKeePassID  "PUClausSa "G:\MESAPPS\TempKeePass.kdbx" "Th1s1saF1n3M355" "G:\MESAPPS\COMMON\RPMISC\PowerShell\Keepass") -eq $true)
     The if the ID PUClausSa is in the KeePass file, then the returned 
     result will be $true
#> 
Function Remove-NPEKeePassID
{
  [CmdletBinding(SupportsShouldProcess=$True)]
  Param(
    [Parameter(Mandatory=$True)] [string]$username,
    [Parameter(Mandatory=$True)] [string]$KPFile,
    [Parameter(Mandatory=$True)] [string]$KPPassword,
    [Parameter(Mandatory=$True)] [string]$KPDir,
    [string]$KPFileKey
  ) # EndParam
  if ((Test-NPEKeePassID $username $KPFile $KPPassword $KPDir $KPFileKey) -eq $true){ 
    #  Changing Password for ID in KeePass
###
    If($KPFileKey){
       $TempKP = $KPDir + '\kpscript.exe -c:DeleteEntry "' + $KPFile + '" -pw:"' + $KPPassword + '" -ref-UserName:"' + $username + '" -CreateBackup -keyfile:"' + $KPFileKey + '"'
    }Else{
       $TempKP = $KPDir + '\kpscript.exe -c:DeleteEntry "' + $KPFile + '" -pw:"' + $KPPassword + '" -ref-UserName:"' + $username + '" -CreateBackup' 
    }
    if ($TestOnly -eq $true){
      Write-Host "TEST ONLY: Next step would delete the ID $($username) in Keepass."
      $Success = $False
    }Else{
      $TempKPOut = [string](Invoke-Expression -Command $TempKP)
      if ($TempKPOut.StartsWith("OK")){
        Write-Host "KeePass deletion process completed OK.   Now we confirm the change."
        #  Checking on deletion in KeePass
###
        If($KPFileKey){
           $TempKP = $KPDir + '\kpscript.exe -c:GetEntryString "' + $KPFile + '" -pw:"' + $KPPassword + '" -Field:Password -ref-UserName:"' + $userid + '" -keyfile:"' + $KPFileKey + '"'
        }Else{
           $TempKP = $KPDir + '\kpscript.exe -c:GetEntryString "' + $KPFile + '" -pw:"' + $KPPassword + '" -Field:Password -ref-UserName:"' + $userid + '"'
        }
        $TempKPOut = [string](Invoke-Expression -Command $TempKP)
        if ($TempKPOut.StartsWith($username)){ 
          Write-Host "$($username) was not deleted in KeePass" -foregroundcolor "Red"
          $Success = $False
        }Else{
          Write-Host "$($username) was deleted from KeePass."
          $Success = $True
        } # EndIf
      }else{
        Write-Host "$($username) NOT deleted successfully in Keepass.  May need to be manually deleted." -backgroundcolor "Red"
        $Success = $False
      } # EndIf
    } # EndIf
  }else{
    Write-Host "$($username) was not found in KeePass. So will not be deleted."
    $Success = $False
  } # EndIf
  Return $Success
} # End Function Remove-NPEKeePassID

